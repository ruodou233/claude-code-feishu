#!/usr/bin/env python3
"""把 CLI 会话搬进 Claude 桌面版（飞书 bridge 起的会话默认不出现在桌面版列表里）。

用法：
  claude-to-desktop                 # 搬最近一个尚未进桌面版的飞书会话
  claude-to-desktop <sessionId>     # 搬指定会话
  claude-to-desktop --list          # 只列出候选，不动手

原理：`/desktop` 是唯一能把会话送进桌面版的官方入口，只能在 TUI 内输入，
这里用伪终端喂进去。往桌面版的元数据目录直接写文件是无效的（两种命名格式都验过）。
"""
import glob, json, os, subprocess, sys, time

PROJ = os.path.expanduser("~/.claude/projects")
DESK = os.path.expanduser("~/Library/Application Support/Claude/claude-code-sessions")


def already_in_desktop():
    ids = set()
    for m in glob.glob(DESK + "/*/*/local_*.json"):
        try:
            ids.add(json.load(open(m)).get("cliSessionId"))
        except Exception:
            pass
    return ids


def session_cwd(path):
    """从 transcript 里读真实 cwd —— 桶名是不可逆编码，反推不出来。"""
    with open(path) as f:
        for line in f:
            try:
                cwd = json.loads(line).get("cwd")
            except Exception:
                continue
            if cwd:
                return cwd
    return None


def candidates(all_sessions=False):
    """默认只列飞书 bridge 起的会话 —— 这才是本脚本要解决的问题；
    其他 CLI 会话可以显式传 id 搬。同一 id 可能出现在多个桶里，按 id 去重。"""
    done = already_in_desktop()
    running = set()
    try:  # 不搬正在跑的会话：resume 一个活着的会话会打架
        out = subprocess.run(["pgrep", "-af", "claude"], capture_output=True, text=True).stdout
        for line in out.splitlines():
            for tok in line.split():
                if len(tok) == 36 and tok.count("-") == 4:
                    running.add(tok)
    except Exception:
        pass
    env_sid = os.environ.get("CLAUDE_SESSION_ID")
    if env_sid:
        running.add(env_sid)

    seen, out = {}, []
    for f in glob.glob(PROJ + "/*/*.jsonl"):
        sid = os.path.basename(f)[:-6]
        if sid in done or sid in running or sid in seen:
            continue
        cwd = session_cwd(f)
        if not cwd:
            continue
        if not all_sessions and "lark-channel-workspaces" not in cwd:
            continue
        seen[sid] = True
        out.append((os.path.getmtime(f), sid, cwd, f))
    return sorted(out, reverse=True)


def move(sid, cwd):
    if not os.path.isdir(cwd):
        print(f"✗ 工作目录不存在：{cwd}")
        return False
    print(f"→ 搬运 {sid}\n  目录 {cwd}")
    # 等 TUI 加载完再喂 /desktop；回车用 \r，菜单类对话框喂不进去但这里不涉及
    sh = (f'(sleep 12; printf "/desktop\\r"; sleep 12) | '
          f'script -q /dev/null claude --resume {sid}')
    subprocess.run(["bash", "-lc", sh], cwd=cwd,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    for _ in range(10):          # 元数据是异步写的，给它一点时间
        if sid in already_in_desktop():
            print("✓ 已出现在桌面版会话列表")
            return True
        time.sleep(1)
    print("✗ 桌面版未收录（Claude Code 可能改了 TUI，导致按键喂不进去）")
    return False


def main():
    flags = {a for a in sys.argv[1:] if a.startswith("--")}
    args = [a for a in sys.argv[1:] if not a.startswith("--")]
    listing = "--list" in flags
    cands = candidates(all_sessions="--all" in flags)

    if listing or (not args and not cands):
        if not cands:
            print("没有待搬运的会话（都已在桌面版里）")
            return
        print(f"待搬运会话（共 {len(cands)} 个，最近 10 个）：")
        for mt, sid, cwd, _ in cands[:10]:
            print(f"  {time.strftime('%m-%d %H:%M', time.localtime(mt))}  {sid}  {cwd}")
        return

    if args:
        sid = args[0]
        hit = [c for c in candidates(all_sessions=True) if c[1] == sid]
        if not hit:
            if sid in already_in_desktop():
                print(f"{sid} 已经在桌面版里了")
                return
            print(f"找不到会话 {sid}")
            sys.exit(1)
        move(sid, hit[0][2])
    else:
        _, sid, cwd, _ = cands[0]
        move(sid, cwd)


if __name__ == "__main__":
    main()
